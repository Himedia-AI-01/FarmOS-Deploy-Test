# Design Ref: §16.2 — farmos-ec2-deploy Module 1
# Project-root .dockerignore. Build context = repo root, so backend/ COPY can succeed
# while runtime artifacts and frontend assets are excluded from the image.

# VCS
.git
.gitignore
.gitattributes
.github

# Python
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.venv
**/venv

# Node
**/node_modules
**/dist
**/.next
**/coverage

# Backend runtime artifacts (must NEVER ship in image)
backend/data
backend/chroma_data
backend/logs
backend/.env
backend/.env.*
backend/cookies.txt
backend/test-results

# Frontend (built separately for nginx in Module 2)
frontend/.env
frontend/.env.*
frontend/dist
frontend/test-results
frontend/playwright-report

# Docs / IDE / OS
docs
**/.DS_Store
**/*.log
**/.idea
**/.vscode
**/*.tmp
**/*.swp

# Misc top-level binaries / artifacts
Web_Starter.exe
Web_Starter.exe.config
shopping_mall
DH11_KY018_WiFi
